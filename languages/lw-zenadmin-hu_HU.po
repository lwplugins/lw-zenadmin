#. Plugin Name of the plugin
#: lw-zenadmin.php
msgid "LW ZenAdmin"
msgstr "LW ZenAdmin"

#. Plugin URI of the plugin
#: lw-zenadmin.php
msgid "https://github.com/lwplugins/lw-zenadmin"
msgstr "https://github.com/lwplugins/lw-zenadmin"

#. Description of the plugin
#: lw-zenadmin.php
msgid ""
"Lightweight admin cleanup — notices sidebar, dashboard widgets, admin menu, "
"and admin bar manager."
msgstr ""
"Könnyűsúlyú admin rendrakás — értesítés-oldalsáv, vezérlőpult-widgetek, "
"admin menü és admin sáv kezelése."

#. Author of the plugin
